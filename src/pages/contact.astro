---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
// import CalendlyEmbed from '../components/CalendlyEmbed.astro';
const contactPage = await getEntry('contact', 'contact');
if (!contactPage) throw new Error('Missing contact content entry');
const { title, description, head, form, details } = contactPage.data;
---

<Base surface="dark" title={title} description={description}>
  <Section tone="dark">
    <div class="contact-head">
      <h1>{head.heading}</h1>
      <p class="contact-head__sub">{head.sub}</p>
    </div>

    <div class="contact-grid">
      {/* Left: Calendly */}
      <div class="contact-col">
        <!-- <CalendlyEmbed /> -->
        <ul class="contact-details" aria-label="Contact details">
          {details.map((item) => (
            <li>
              <span class="eyebrow">{item.label}</span>
              <a href={item.href}>{item.value}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Right: form + details */}
      <div class="contact-col">
        <div class="contact-status" aria-live="polite">
          <div class="contact-success" data-contact-success hidden tabindex="-1">
            <h2 class="contact-success__title">{form.successTitle}</h2>
            <p class="contact-success__body">{form.successMessage}</p>
          </div>
        </div>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="contact-form"
          data-contact-form
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="contact-form__hp" aria-hidden="true">
            <label>
              {form.honeypotLabel}
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          {form.fields.map((f) => (
            <div class="contact-form__field">
              <label for={f.id}>
                {f.label}
                {f.optionalLabel && <span> {f.optionalLabel}</span>}
              </label>
              {f.type === 'textarea' ? (
                <textarea id={f.id} name={f.id} rows={f.rows ?? 5} required={f.required}></textarea>
              ) : (
                <input
                  id={f.id}
                  name={f.id}
                  type={f.type}
                  autocomplete={f.autocomplete}
                  required={f.required}
                />
              )}
            </div>
          ))}

          <p class="contact-form__error" data-contact-error aria-live="polite" hidden>
            {form.errorMessage}
          </p>

          <button
            type="submit"
            class="contact-form__submit"
            data-contact-submit
            data-sending-label={form.sendingLabel}
          >{form.submitLabel}</button>
        </form>
      </div>
    </div>
  </Section>
</Base>

<script>
  // Progressive enhancement: submit the Netlify form over AJAX so we can show
  // an inline success/error notice without a full-page redirect. If this script
  // never runs (no JS), the form still POSTs natively to Netlify.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const submit = form.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const errorNotice = form.querySelector<HTMLElement>('[data-contact-error]');
    const success = document.querySelector<HTMLElement>('[data-contact-success]');
    const sendingLabel = submit?.dataset.sendingLabel ?? '';
    const idleLabel = submit?.textContent ?? '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (errorNotice) errorNotice.hidden = true;
      if (submit) {
        submit.disabled = true;
        if (sendingLabel) submit.textContent = sendingLabel;
      }

      try {
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
        });
        if (!response.ok) throw new Error(`Request failed: ${response.status}`);

        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.focus();
        }
      } catch {
        if (errorNotice) errorNotice.hidden = false;
        if (submit) {
          submit.disabled = false;
          submit.textContent = idleLabel;
        }
      }
    });
  }
</script>

<style>
  .contact-head {
    max-width: 48rem;
    margin-bottom: 5rem;
  }

  .contact-head h1 {
    font-size: var(--text-display-lg);
    margin: 1.5rem 0 2rem;
  }

  .contact-head__sub {
    font-size: 1.125rem;
    color: rgba(250, 250, 247, 0.75);
    max-width: 58ch;
    margin: 0;
  }

  .contact-grid {
    display: grid;
    gap: 4rem;
  }

  @media (min-width: 1000px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  .contact-details {
    list-style: none;
    /*padding: 3rem 0 0;*/
    /*margin: 3rem 0 0;*/
    /*border-top: 1px solid var(--color-hairline-dark);*/
    display: grid;
    gap: 1.5rem;
  }

  .contact-details li {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .contact-details a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .contact-details a:hover {
    color: var(--color-accent);
  }

  .contact-form {
    display: grid;
    gap: 1.5rem;
  }

  .contact-form__hp {
    position: absolute;
    left: -9999px;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-form__field label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: rgba(250, 250, 247, 0.6);
  }

  .contact-form__field label span {
    text-transform: none;
    letter-spacing: 0;
    opacity: 0.7;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    background: rgba(250, 250, 247, 0.04);
    border: 1px solid var(--color-hairline-dark);
    border-radius: 10px;
    padding: 0.875rem 1rem;
    color: var(--color-ink);
    font: inherit;
    font-size: 1rem;
    width: 100%;
  }

  .contact-form__field input::placeholder,
  .contact-form__field textarea::placeholder {
    color: rgba(250, 250, 247, 0.5);
  }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background: rgba(255, 255, 255, 0.08);
  }

  .contact-form__field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .contact-form__submit {
    justify-self: start;
    background: #ffffff;
    color: var(--color-brand-purple-ink);
    border: none;
    padding: 1rem 2rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: background 140ms ease, color 140ms ease, transform 200ms ease;
  }

  .contact-form__submit:hover {
    background: var(--color-accent);
    color: var(--color-brand-purple-ink);
    transform: translateY(-1px);
  }

  .contact-form__submit:disabled {
    opacity: 0.6;
    cursor: progress;
    transform: none;
  }

  /* Inline error notice — stays put so the user can retry */
  .contact-form__error {
    margin: 0;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-accent);
    border-radius: 10px;
    background: rgba(250, 250, 247, 0.04);
    color: rgba(250, 250, 247, 0.85);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  /* Success notice — replaces the form once submitted */
  .contact-status:empty {
    display: none;
  }

  .contact-success {
    border: 1px solid var(--color-hairline-dark);
    border-left: 3px solid var(--color-accent);
    border-radius: 12px;
    background: rgba(250, 250, 247, 0.04);
    padding: 2rem;
  }

  .contact-success:focus {
    outline: none;
  }

  .contact-success__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
    color: var(--color-accent);
  }

  .contact-success__body {
    margin: 0;
    color: rgba(250, 250, 247, 0.75);
    font-size: 1.0625rem;
    line-height: 1.55;
    max-width: 46ch;
  }

  /* `.contact-form` is display:grid, which would override the `hidden`
     attribute's UA `display:none` — force it, plus the notices for safety. */
  .contact-form[hidden],
  .contact-form__error[hidden],
  .contact-success[hidden] {
    display: none;
  }

</style>
